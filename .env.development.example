# Direct-host development template. Copy to .env; never use in production.
SECRET_KEY=django-insecure-local-development-only-do-not-use-in-production
JWT_SIGNING_KEY=django-insecure-local-jwt-signing-key-do-not-use-in-production

# PostgreSQL running directly on the local host.
DB_NAME=wine_shop
DB_USER=wine_shop
DB_PASSWORD=wine-shop-development-only
DB_HOST=localhost
DB_PORT=5432

# Redis running directly on the local host.
CACHE_REDIS_URL=redis://localhost:6379/0
SECURITY_REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# Browser requests made from the local frontend.
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=20
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

OTP_EXPIRY_SECONDS=120
OTP_VERIFICATION_MAX_ATTEMPTS=5
OTP_VERIFICATION_LOCK_SECONDS=300
PASSWORD_LOGIN_MAX_ATTEMPTS=5
PASSWORD_LOGIN_LOCK_SECONDS=300

AUTH_ANON_THROTTLE_RATE=100/day
AUTH_USER_THROTTLE_RATE=1000/day
OTP_REQUEST_THROTTLE_RATE=1/m
OTP_VERIFY_THROTTLE_RATE=10/m
SIGNUP_THROTTLE_RATE=5/hour
PASSWORD_LOGIN_THROTTLE_RATE=10/m
