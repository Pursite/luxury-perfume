# Production template. Copy to .env.production on the deployment host, replace every
# placeholder, and restrict the resulting file to its owner.
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=replace-with-a-long-random-django-secret
JWT_SIGNING_KEY=replace-with-a-dedicated-long-random-jwt-signing-key

# Required production host and browser-origin policy.
ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com

# PostgreSQL is the internal Docker Compose service; do not publish its port.
DB_NAME=replace-with-production-database-name
DB_USER=replace-with-production-database-user
DB_PASSWORD=replace-with-a-database-password
DB_HOST=db
DB_PORT=5432
DB_CONNECT_TIMEOUT_SECONDS=3

# Redis is the internal Docker Compose service for cache, security state,
# Celery broker, and Celery results. Do not publish its port.
REDIS_SOCKET_TIMEOUT_SECONDS=2
CACHE_REDIS_URL=redis://redis:6379/0
SECURITY_REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3
CELERY_RESULT_EXPIRES_SECONDS=86400

# Production HTTPS and cookie policy.
SECURE_PROXY_SSL_HEADER_ENABLED=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# SMTP email delivery.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-an-smtp-username
EMAIL_HOST_PASSWORD=replace-with-an-smtp-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Wine Shop <no-reply@example.com>

# JWT lifetime defaults: 20 minutes access, 30 days refresh.
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=20
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# OTP verification and temporary credential lockouts.
OTP_EXPIRY_SECONDS=120
OTP_VERIFICATION_MAX_ATTEMPTS=5
OTP_VERIFICATION_LOCK_SECONDS=300
PASSWORD_LOGIN_MAX_ATTEMPTS=5
PASSWORD_LOGIN_LOCK_SECONDS=300

# Authentication endpoint throttles.
AUTH_ANON_THROTTLE_RATE=100/day
AUTH_USER_THROTTLE_RATE=1000/day
OTP_REQUEST_THROTTLE_RATE=1/m
OTP_VERIFY_THROTTLE_RATE=10/m
SIGNUP_THROTTLE_RATE=5/hour
PASSWORD_LOGIN_THROTTLE_RATE=10/m
