# Production template. Copy to .env on the deployment host, replace every
# placeholder, and restrict the resulting file to its owner with chmod 600 .env.
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=replace-with-a-long-random-django-secret
# Use a distinct cryptographically random JWT signing key of at least 32 bytes.
JWT_SIGNING_KEY=replace-with-a-dedicated-long-random-jwt-signing-key

# Django serves shop.exonplus.ir; the React storefront is built and served
# separately at www.exonplus.ir. api.exonplus.ir remains unrelated VPN/3x-ui
# infrastructure and must not route to this Django application.
ALLOWED_HOSTS=shop.exonplus.ir
CORS_ALLOWED_ORIGINS=https://www.exonplus.ir
CSRF_TRUSTED_ORIGINS=https://www.exonplus.ir

# PostgreSQL is the internal Docker Compose service; do not publish its port.
DB_NAME=replace-with-production-database-name
DB_USER=replace-with-production-database-user
DB_PASSWORD=replace-with-a-database-password
DB_HOST=db
DB_PORT=5432
DB_CONNECT_TIMEOUT_SECONDS=3

# Redis is the internal Docker Compose service for cache, security state,
# Celery broker, and Celery results. Do not publish its port.
REDIS_SOCKET_TIMEOUT_SECONDS=2
CACHE_REDIS_URL=redis://redis:6379/0
SECURITY_REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3
CELERY_RESULT_EXPIRES_SECONDS=86400

# Production HTTPS and cookie policy.
SECURE_PROXY_SSL_HEADER_ENABLED=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# Exactly one host-managed Nginx proxy sits in front of the loopback Gunicorn listener.
DRF_NUM_PROXIES=1

# JWT lifetime defaults: 20 minutes access, 30 days refresh.
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=20
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# OTP verification and temporary credential lockouts.
OTP_EXPIRY_SECONDS=120
OTP_VERIFICATION_MAX_ATTEMPTS=5
OTP_VERIFICATION_LOCK_SECONDS=300
PASSWORD_LOGIN_MAX_ATTEMPTS=5
PASSWORD_LOGIN_LOCK_SECONDS=300

# Authentication endpoint throttles.
AUTH_ANON_THROTTLE_RATE=100/day
AUTH_USER_THROTTLE_RATE=1000/day
PRODUCT_CATALOGUE_THROTTLE_RATE=120/m
TOKEN_REFRESH_THROTTLE_RATE=30/m
OTP_REQUEST_THROTTLE_RATE=1/m
OTP_REQUEST_IP_THROTTLE_RATE=10/m
OTP_VERIFY_THROTTLE_RATE=10/m
OTP_VERIFY_IP_THROTTLE_RATE=10/m
SIGNUP_THROTTLE_RATE=5/hour
PASSWORD_LOGIN_THROTTLE_RATE=10/m

# New Orders snapshot this exact server-owned IRT amount; clients cannot supply shipping.
ORDER_SHIPPING_FLAT_RATE_IRT=350000.00

# Keep disabled until a reviewed provider adapter and provider-specific secrets
# are present. Enabling with placeholder values makes system checks fail closed.
PAYMENTS_ENABLED=False
PAYMENT_PROVIDER=replace-after-provider-selection
PAYMENT_CURRENCY=IRT
PAYMENT_PUBLIC_BASE_URL=https://shop.exonplus.ir
PAYMENT_FRONTEND_RESULT_URL=https://www.exonplus.ir/payment-result
PAYMENT_ALLOWED_REDIRECT_HOSTS=replace-with-provider-host
PAYMENT_PROVIDER_CONNECT_TIMEOUT_SECONDS=3
PAYMENT_PROVIDER_READ_TIMEOUT_SECONDS=7
PAYMENT_RECONCILIATION_HORIZON_HOURS=24
PAYMENT_INITIALIZE_THROTTLE_RATE=10/m
PAYMENT_CALLBACK_THROTTLE_RATE=120/m
PAYMENT_TRUST_PROXY_HEADERS=False
PAYMENT_TRUSTED_PROXY_CIDRS=replace-with-reviewed-proxy-cidrs
PAYMENT_AUDIT_RETENTION_DAYS=180

# Keep SMS disabled. Provider-specific credentials are introduced only with a
# separately reviewed adapter; do not add them to this generic template.
SMS_ENABLED=False
SMS_PROVIDER=replace-after-provider-selection
SMS_CONNECT_TIMEOUT_SECONDS=3
SMS_READ_TIMEOUT_SECONDS=7
SMS_OPERATION_LEASE_SECONDS=30
SMS_MAX_ATTEMPTS=5
SMS_RETRY_BASE_SECONDS=5
SMS_RETRY_MAX_SECONDS=300
SMS_RECIPIENT_RETENTION_DAYS=180
