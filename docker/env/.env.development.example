# Docker Compose development template. Copy to .env; never use it in production.
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=django-insecure-local-development-only-do-not-use-in-production
# Development-only key; production needs a distinct random value of at least 32 bytes.
JWT_SIGNING_KEY=django-insecure-local-jwt-signing-key-do-not-use-in-production

# PostgreSQL and Redis are internal Docker Compose services. Only Django is
# published to the loopback interface for local development.
DJANGO_HOST_PORT=8000
DB_NAME=wine_shop
DB_USER=wine_shop
DB_PASSWORD=wine-shop-development-only
DB_HOST=db
DB_PORT=5432
DB_CONNECT_TIMEOUT_SECONDS=3

# Redis service URLs.
REDIS_SOCKET_TIMEOUT_SECONDS=2
CACHE_REDIS_URL=redis://redis:6379/0
SECURITY_REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3
CELERY_RESULT_EXPIRES_SECONDS=86400

# Browser requests made from the local frontend.
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=20
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

OTP_EXPIRY_SECONDS=120
OTP_VERIFICATION_MAX_ATTEMPTS=5
OTP_VERIFICATION_LOCK_SECONDS=300
PASSWORD_LOGIN_MAX_ATTEMPTS=5
PASSWORD_LOGIN_LOCK_SECONDS=300

AUTH_ANON_THROTTLE_RATE=100/day
AUTH_USER_THROTTLE_RATE=1000/day
OTP_REQUEST_THROTTLE_RATE=1/m
OTP_REQUEST_IP_THROTTLE_RATE=1/m
OTP_VERIFY_THROTTLE_RATE=10/m
OTP_VERIFY_IP_THROTTLE_RATE=10/m
SIGNUP_THROTTLE_RATE=5/hour
PASSWORD_LOGIN_THROTTLE_RATE=10/m
